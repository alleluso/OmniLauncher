<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ControlTheme x:Key="HubScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#5D5868"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#8C819F"/>
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="HubScrollPage" TargetType="RepeatButton">
            <Setter Property="Template">
                <ControlTemplate><Border Background="Transparent"/></ControlTemplate>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="HubScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="{TemplateBinding Background}">
                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}"
                               DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource HubScrollPage}"
                                              Focusable="False" AutomationProperties.Name="Scroll backward"/>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource HubScrollPage}"
                                              Focusable="False" AutomationProperties.Name="Scroll forward"/>
                            </Track.IncreaseButton>
                            <Thumb Theme="{StaticResource HubScrollThumb}" AutomationProperties.Name="Scroll position"/>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:vertical">
                <Setter Property="Width" Value="14"/>
                <Setter Property="Margin" Value="12,8,8,8"/>
            </Style>
            <Style Selector="^:vertical /template/ Track">
                <Setter Property="IsDirectionReversed" Value="True"/>
            </Style>
            <Style Selector="^:vertical /template/ Thumb">
                <Setter Property="Width" Value="6"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            <Style Selector="^:horizontal">
                <Setter Property="Height" Value="14"/>
                <Setter Property="Margin" Value="8,8,8,4"/>
            </Style>
            <Style Selector="^:horizontal /template/ Thumb">
                <Setter Property="Height" Value="6"/>
                <Setter Property="MinWidth" Value="32"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ControlTheme>
    </Styles.Resources>
    <!-- Keep a separate gutter: the thumb never expands over the content. -->
    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="Theme" Value="{StaticResource HubScrollBar}"/>
    </Style>
</Styles>

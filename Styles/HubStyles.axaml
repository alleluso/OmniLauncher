<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    
    <Style Selector="TextBlock.header">
        <Setter Property="FontSize" Value="{StaticResource PageTitleFontSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,24,0,12"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="#C0392B"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#E74C3C"/>
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#922B21"/>
    </Style>

    <!-- ── Sidebar navigation items ── -->
    <Style Selector="Button.nav-item">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#B0B0B0"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Button.nav-item:pointerover">
        <Setter Property="Background" Value="#22FFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.nav-item.active">
        <Setter Property="Background" Value="#264FC3F7"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.nav-item.active:pointerover">
        <Setter Property="Background" Value="#264FC3F7"/>
    </Style>

    <!-- ── Filter pill tabs (Recent / Favorites / Tutorials) ── -->
    <Style Selector="RadioButton.tab-pill">
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Foreground" Value="#AAAAAA"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border" CornerRadius="16" Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.tab-pill:checked /template/ Border#PART_Border">
        <Setter Property="Background" Value="White"/>
    </Style>
    <Style Selector="RadioButton.tab-pill:checked">
        <Setter Property="Foreground" Value="#1E1E1E"/>
    </Style>
    <Style Selector="RadioButton.tab-pill:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <!-- ── Header search box ── -->
    <Style Selector="TextBox.search">
        <Setter Property="Background" Value="#22FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="4,0,12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

</Styles>

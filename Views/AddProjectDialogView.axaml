<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniLauncher.ViewModels"
             xmlns:conv="using:OmniLauncher.Converters"
             xmlns:svg="using:Avalonia.Svg.Skia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="420"
             Classes="dialog" x:Class="OmniLauncher.Views.AddProjectDialogView"
             x:DataType="vm:AddProjectDialogViewModel">

    <Design.DataContext>
        <vm:AddProjectDialogViewModel/>
    </Design.DataContext>

    <ThemeVariantScope RequestedThemeVariant="Dark">
        <Border Classes="dialog-shell" MaxWidth="580" MaxHeight="760" Margin="24"
                VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Classes="dialog-heading">
                    <TextBlock Text="Add project" Classes="dialog-title"/>
                    <TextBlock Text="Choose an application and add a project to your library." Classes="dialog-description"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,0,24,24" Spacing="16">
                        <!-- Project type -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Application" Classes="dialog-label"/>
                            <ComboBox Classes="dialog-input" ItemsSource="{Binding ProjectTypes}"
                                      SelectedItem="{Binding SelectedProjectType}"
                                      IsEnabled="{Binding CanChooseApplication}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <svg:Svg Path="{Binding Converter={x:Static conv:ProjectTypeToIconConverter.Instance}}"
                                                     Width="20" Height="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Converter={x:Static conv:EnumToFriendlyStringConverter.Instance}}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
            
                        <!-- Name -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Project name" Classes="dialog-label"/>
                            <TextBox Classes="dialog-input" Text="{Binding ProjectName}" PlaceholderText="My Project"/>
                        </StackPanel>
            
                        <!-- Project folder -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding PathLoader.ProjectPathLabel}" Classes="dialog-label"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Classes="dialog-input" Grid.Column="0" Text="{Binding ProjectPath}"
                                         PlaceholderText="{Binding PathLoader.ProjectPathPlaceholder}"/>
                                <Grid Grid.Column="1">
                                    <Button Classes="dialog-action" Content="Browse" IsVisible="{Binding !HasPathChoices}"
                                            Command="{Binding BrowsePathCommand}"
                                            CommandParameter="{Binding $parent[Window]}"/>
                                    <Button Classes="dialog-action" Content="Browse ▾" IsVisible="{Binding HasPathChoices}">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="{Binding PathLoader.FolderPickerTitle}" Click="OnBrowseFolder"/>
                                                <MenuItem Header="{Binding PathLoader.FilePickerTitle}" Click="OnBrowseFile"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </Grid>
                        </StackPanel>
            
                        <!-- Cover image (optional) -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Cover image (optional)" Classes="dialog-label"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Classes="dialog-input" Grid.Column="0" Text="{Binding ImagePath}"
                                         PlaceholderText="Select an image or leave empty…"/>
                                <Button Classes="dialog-action" Grid.Column="1" Content="Browse"
                                        Command="{Binding BrowseImageCommand}"
                                        CommandParameter="{Binding $parent[Window]}"/>
                            </Grid>
                        </StackPanel>
            
                        <TextBlock Text="{Binding PathError}" Classes="dialog-error" IsVisible="{Binding PathError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Classes="dialog-footer">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Cancel" Classes="dialog-action" Command="{Binding CancelCommand}"/>
                        <Button Content="Add project" Classes="dialog-action dialog-primary" Command="{Binding ConfirmCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </ThemeVariantScope>
</UserControl>

